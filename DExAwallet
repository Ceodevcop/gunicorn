# Function to create API signature
def create_signature(endpoint, params):
    params['api_key'] = API_KEY
    params['req_time'] = str(int(time.time() * 1000))
    params['sign'] = hashlib.md5((str(params['req_time']) + endpoint + API_SECRET).encode()).hexdigest()
    return params

# Function to fetch market data
def get_market_data(symbol):
    url = 'https://api.bitget.com/api/spot/v1/market/tickers'
    params = {'symbol': symbol}
    params = create_signature('/api/spot/v1/market/tickers', params)
    response = requests.get(url, params=params)
    return response.json()

# Function to place an order
def place_order(symbol, side, price, quantity):
    url = 'https://api.bitget.com/api/spot/v1/order'
    params = {
        'symbol': symbol,
        'price': price,
        'quantity': quantity,
        'side': side,
        'order_type': 'market'
    }
    params = create_signature('/api/spot/v1/order', params)
    response = requests.post(url, params=params)
    return response.json()

